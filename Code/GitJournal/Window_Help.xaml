<Window x:Class="GitJournal.Window_Help"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GitJournal"
        mc:Ignorable="d"
        Title="Aide - Jeton GitHub"
        Background="#222"
        Foreground="White"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Border Margin="20" Padding="20" Background="#333" CornerRadius="10">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="Bold" Margin="0 0 0 10"
                           Text="Générer un jeton d’accès personnel GitHub (PAT)" />

                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">
                    1. Allez sur 
                    <Hyperlink NavigateUri="https://github.com/settings/tokens" RequestNavigate="Hyperlink_RequestNavigate">
                        https://github.com/settings/tokens
                    </Hyperlink>
                </TextBlock>

                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">
                    2. Cliquez sur « Générer un nouveau jeton ».
                </TextBlock>

                <TextBlock TextWrapping="Wrap">
                    3. Donnez un nom, par exemple « GitJournal ».
                </TextBlock>

                <TextBlock TextWrapping="Wrap">
                    4. Choisissez une date d’expiration.
                </TextBlock>

                <TextBlock TextWrapping="Wrap">
                    5. Cochez les permissions nécessaires :
                    <LineBreak/>• repo
                    <LineBreak/>• read:org (si accès à des dépôts d’organisation)
                </TextBlock>

                <TextBlock TextWrapping="Wrap" Margin="0 10 0 0">
                    6. Cliquez sur « Générer le jeton ».
                </TextBlock>

                <TextBlock TextWrapping="Wrap" Foreground="OrangeRed" FontWeight="Bold" Margin="0 5 0 0">
                    ⚠️ Copiez le jeton immédiatement – il ne sera plus visible ensuite.
                </TextBlock>
            </StackPanel>
    </Border>
</Window>
